{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quality Measurement Report",
  "type": "object",
  "required": ["schema_version", "run", "progress", "measurements"],
  "properties": {
    "schema_version": { "type": "string" },
    "run": {
      "type": "object",
      "required": ["status", "started_at", "completed_at"],
      "properties": {
        "status": { "enum": ["completed", "completed_with_errors"] },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "commit": { "type": ["string", "null"] },
        "tag": { "type": ["string", "null"] },
        "application_worktree_clean": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "progress": {
      "type": "object",
      "required": ["total", "completed", "percent", "counts"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "completed": { "type": "integer", "minimum": 0 },
        "percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "counts": {
          "type": "object",
          "properties": {
            "passed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "skipped": { "type": "integer", "minimum": 0 },
            "error": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      },
      "additionalProperties": true
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "enum": ["pending", "running", "passed", "failed", "skipped", "error"] },
          "value": {},
          "unit": { "type": "string" },
          "target": {},
          "message": { "type": "string" },
          "family": { "type": "string" },
          "tool": { "type": "string" },
          "command": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
